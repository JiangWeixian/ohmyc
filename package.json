{
  "name": "claudeui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "description": "Claude UI Monorepo",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "build": "pnpm --filter @ohmyc/timeline build && pnpm -r --filter !@ohmyc/timeline build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @ohmyc/timeline build && concurrently -n server,ui -c blue,green \"pnpm --filter @ohmyc/cli dev:server\" \"pnpm --filter @ohmyc/ui dev\"",
    "ci:version": "pnpm changeset version",
    "ci:publish": "pnpm run build && pnpm changeset publish",
    "ci:snapshot": "pnpm changeset version --snapshot snapshot",
    "ci:prerelease": "pnpm run build && pnpm changeset publish --no-git-tag --tag snapshot",
    "lint:fix": "eslint --config ./eslint.config.mjs --fix",
    "prepare": "husky install"
  },
  "lint-staged": {
    "**/**/*.{js,ts,tsx,json,yml,yaml,md}": ["eslint --fix"]
  },
  "dependencies": {
    "untildify": "^6.0.0"
  },
  "devDependencies": {
    "@aiou/eslint-config": "0.0.0-snapshot-20260503074141",
    "@changesets/cli": "^2.26.0",
    "@opencode-ai/plugin": "^1.14.31",
    "@types/node": "^20.12.7",
    "bun-types": "^1.3.13",
    "concurrently": "^9.2.1",
    "cz-emoji": "^1.3.1",
    "eslint": "^10.2.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
