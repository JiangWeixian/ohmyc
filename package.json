{
  "name": "claudeui",
  "version": "1.0.0",
  "private": true,
  "description": "Claude UI Monorepo",
  "scripts": {
    "build": "pnpm --filter @claudeui/ui build && pnpm --filter @claudeui/cli build",
    "test": "pnpm -r test",
    "dev": "concurrently -n server,ui -c blue,green \"pnpm --filter @claudeui/cli dev:server\" \"pnpm --filter @claudeui/ui dev\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pnpm": "^8.0.0"
  },
  "dependencies": {
    "untildify": "^6.0.0"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
