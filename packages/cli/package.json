{
  "name": "@ohmyc/cli",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "cui": "dist/index.mjs",
    "ohmyc": "dist/index.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "build:full": "pnpm --filter @ohmyc/ui build && tsup",
    "dev": "tsx watch src/index.ts start --api-only --cwd $INIT_CWD",
    "dev:server": "tsx watch src/index.ts --cwd $INIT_CWD",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build:full"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@fastify/static": "^7.0.3",
    "@ohmyc/shared": "workspace:*",
    "@ohmyc/timeline": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "cac": "^6.7.14",
    "fastify": "^4.26.2",
    "get-port": "^7.1.0",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "proper-lockfile": "^4.1.2",
    "untildify": "^6.0.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@ohmyc/ui": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.12.7",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
