{
  "name": "@ohmyc/cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JiangWeixian/ohmyc",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ohmyc": "dist/index.mjs"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "start": "node dist/index.mjs --help",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ohmyc/shared": "workspace:*",
    "@ohmyc/timeline": "workspace:*",
    "@ohmyc/timeline-plugin": "0.0.0-snapshot-20260615111700",
    "cac": "^6.7.14",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
