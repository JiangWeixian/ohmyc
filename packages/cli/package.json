{
  "name": "@ohmyc/cli",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist", "README.md"],
  "bin": {
    "cui": "dist/index.mjs",
    "ohmyc": "dist/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "build:full": "pnpm --filter @ohmyc/ui build && tsup",
    "dev": "concurrently -n build,server -c yellow,blue \"tsup --watch\" \"node --watch-path=dist dist/index.mjs\"",
    "dev:server": "concurrently -n build,server -c yellow,blue \"tsup --watch\" \"node --watch-path=dist dist/index.mjs start --api-only --port 3000 --cwd $INIT_CWD\"",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build:full && node scripts/prepublish.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@fastify/static": "^7.0.3",
    "@ohmyc/shared": "workspace:*",
    "@ohmyc/timeline": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "cac": "^6.7.14",
    "fastify": "^4.26.2",
    "get-port": "^7.1.0",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "proper-lockfile": "^4.1.2",
    "untildify": "^6.0.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.12.7",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
