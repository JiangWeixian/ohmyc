{
  "name": "@ohmyc/timeline",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JiangWeixian/ohmyc",
    "directory": "packages/timeline"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "default": "./dist/writer.js"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "default": "./dist/ingest.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./node-sqlite": {
      "types": "./dist/node-sqlite.d.ts",
      "default": "./dist/node-sqlite.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/writer.ts src/ingest.ts src/migrate.ts src/node-sqlite.ts src/schema.ts --format esm --dts --platform node --external node:sqlite --clean",
    "dev": "tsup src/index.ts src/writer.ts src/ingest.ts src/migrate.ts src/node-sqlite.ts src/schema.ts --format esm --dts --platform node --external node:sqlite --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
